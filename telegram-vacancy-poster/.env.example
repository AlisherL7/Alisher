# Telegram API credentials — получить на https://my.telegram.org/apps
API_ID=
API_HASH=
# Номер телефона личного аккаунта в формате +49...
PHONE_NUMBER=
# Имя файла сессии Telethon (создаётся при первом интерактивном логине)
SESSION_NAME=nas_connect_poster

# === Rate limiting ===
# Жёсткий потолок постов в сутки. Для НОВОГО/непрогретого аккаунта держите
# низким первые недели (см. WARMUP_*), для старого проверенного аккаунта
# можно сразу ставить близко к максимуму (но не выше 25 — это потолок из
# соображений антиспама Telegram, а не техническое ограничение).
DAILY_POST_LIMIT=25

# Прогрев для нового аккаунта: количество дней с first_run и лимит поста
# на первый день прогрева. Лимит линейно растёт от WARMUP_START_LIMIT до
# DAILY_POST_LIMIT за WARMUP_DAYS. Для старого/доверенного аккаунта
# поставьте WARMUP_DAYS=0, чтобы сразу использовать DAILY_POST_LIMIT.
WARMUP_DAYS=14
WARMUP_START_LIMIT=5

# Пауза между постами, секунды (min, max) — random.uniform
POST_DELAY_MIN=420
POST_DELAY_MAX=1500

# Ночная пауза по Берлину (не постить в это окно)
NIGHT_START_HOUR=23
NIGHT_END_HOUR=7

# === joiner.py ===
JOIN_DAILY_LIMIT=6
JOIN_DELAY_MIN_MINUTES=15
JOIN_DELAY_MAX_MINUTES=40

# Путь к SQLite базе состояния
DB_PATH=state.db

# Telegram user_id владельца (вы), куда слать алерты через Saved Messages.
# Если не задано, используется "me" (аккаунт, под которым авторизован клиент).
ALERT_PEER=me
